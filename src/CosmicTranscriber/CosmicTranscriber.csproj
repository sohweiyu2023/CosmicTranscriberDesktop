<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF needs no WinRT projection. Preserve the existing Windows 10 support
         declaration independently of the versionless Windows API target. -->
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <AssemblyName>CosmicTranscriber</AssemblyName>
    <RootNamespace>CosmicTranscriber</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\CosmicTranscriber.ico')">Assets\CosmicTranscriber.ico</ApplicationIcon>
    <Version>1.0.27</Version>
    <AssemblyVersion>1.0.27.0</AssemblyVersion>
    <FileVersion>1.0.27.0</FileVersion>
    <InformationalVersion>1.0.27</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>Soh Wei Yu</Authors>
    <Copyright>Copyright (c) 2026 Soh Wei Yu</Copyright>
    <Description>A polished Windows desktop studio for long-form OpenAI audio transcription.</Description>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.13" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041.0</_Parameter1>
    </AssemblyAttribute>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\NAudio-3.3.0-MIT.txt;..\..\licenses\System.Numerics.Tensors-10.0.13-MIT.txt;..\..\licenses\System.Numerics.Tensors-10.0.13-THIRD-PARTY-NOTICES.txt;..\..\licenses\Apache-2.0.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
