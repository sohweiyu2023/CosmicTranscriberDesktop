<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0B0A17</Color>
    <Color x:Key="AppBackgroundSecondColor">#15112D</Color>
    <Color x:Key="SurfaceColor">#D9161427</Color>
    <Color x:Key="SurfaceElevatedColor">#F21E1B35</Color>
    <Color x:Key="SurfaceHoverColor">#FF292442</Color>
    <Color x:Key="BorderColor">#3DFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFF9F5FF</Color>
    <Color x:Key="TextSecondaryColor">#FFB9B2C8</Color>
    <Color x:Key="TextMutedColor">#FF958C9E</Color>
    <Color x:Key="AccentColor">#FFFFCF6A</Color>
    <Color x:Key="AccentTextColor">#FFFFCF6A</Color>
    <Color x:Key="AccentStrongColor">#FFFFB83F</Color>
    <Color x:Key="AccentSoftColor">#2EFFE09A</Color>
    <Color x:Key="VioletColor">#FF9F7CFF</Color>
    <Color x:Key="CyanColor">#FF67D9FF</Color>
    <Color x:Key="SuccessColor">#FF66E3A4</Color>
    <Color x:Key="WarningSoftColor">#2BFFC56E</Color>
    <Color x:Key="WarningColor">#FFFFC56E</Color>
    <Color x:Key="ErrorColor">#FFFF7D8D</Color>
    <Color x:Key="InfoColor">#FF72B6FF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppBackgroundSecondBrush" Color="{DynamicResource AppBackgroundSecondColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{DynamicResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{DynamicResource VioletColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource WarningSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF090814" Offset="0" />
        <GradientStop Color="#FF14102B" Offset="0.58" />
        <GradientStop Color="#FF0C1221" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
