<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#FFF5F1E8</Color>
    <Color x:Key="AppBackgroundSecondColor">#FFE9E1D4</Color>
    <Color x:Key="SurfaceColor">#F5FFFDF8</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#FFF1EADF</Color>
    <Color x:Key="BorderColor">#2B3C2D4D</Color>
    <Color x:Key="TextPrimaryColor">#FF241D2E</Color>
    <Color x:Key="TextSecondaryColor">#FF5F5668</Color>
    <Color x:Key="TextMutedColor">#FF6A6072</Color>
    <Color x:Key="AccentColor">#FFB47A00</Color>
    <Color x:Key="AccentTextColor">#FF7A4E00</Color>
    <Color x:Key="AccentStrongColor">#FF9B5700</Color>
    <Color x:Key="AccentSoftColor">#26D29A24</Color>
    <Color x:Key="VioletColor">#FF7554C0</Color>
    <Color x:Key="CyanColor">#FF1685A8</Color>
    <Color x:Key="SuccessColor">#FF0D7048</Color>
    <Color x:Key="WarningSoftColor">#1F9B5700</Color>
    <Color x:Key="WarningColor">#FF9B5700</Color>
    <Color x:Key="ErrorColor">#FFB63E54</Color>
    <Color x:Key="InfoColor">#FF225F9E</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppBackgroundSecondBrush" Color="{DynamicResource AppBackgroundSecondColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{DynamicResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{DynamicResource VioletColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource WarningSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8F4EC" Offset="0" />
        <GradientStop Color="#FFF2EADF" Offset="0.58" />
        <GradientStop Color="#FFE9EEF0" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
