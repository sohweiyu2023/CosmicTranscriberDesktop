<Window x:Class="CosmicTranscriber.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Cosmic Transcriber"
        Width="540"
        Height="620"
        MinWidth="420"
        MinHeight="440"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Background="{DynamicResource WindowGradientBrush}" Margin="0">
        <Border Margin="24" Style="{StaticResource CardStyle}" Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="22"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="✦" FontSize="38" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="COSMIC TRANSCRIBER" FontFamily="{StaticResource DisplayFont}"
                               FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                            Padding="10,4" HorizontalAlignment="Center" Margin="0,7,0,0">
                        <TextBlock x:Name="AboutVersionText" Text="Version"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Created and maintained by Soh Wei Yu" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cosmic Transcriber is free to use. If it saves you time and you would like to support continued maintenance, an optional PayPal contribution is appreciated - never required."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />

                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Awakening to Reality" FontWeight="SemiBold" />
                            <TextBlock Text="https://www.awakeningtoreality.com/"
                                       TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}"
                                       Margin="0,4,0,0" />
                            <Button Content="Open website" Click="OpenWebsite_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    AutomationProperties.Name="Open Awakening to Reality website" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Optional PayPal support" FontWeight="SemiBold" />
                            <TextBlock Text="sohweiyu@outlook.com"
                                       Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0" />
                            <Button Content="Copy PayPal email" Click="CopyPayPalEmail_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    AutomationProperties.Name="Copy PayPal email address" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Independent software. Not affiliated with or endorsed by OpenAI. API usage is billed by OpenAI under the user's own account."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                               Margin="6,16,6,0" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="4" Content="Close" Click="Close_Click"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="120"
                        HorizontalAlignment="Center" IsDefault="True" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
