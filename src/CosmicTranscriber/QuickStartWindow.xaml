<Window x:Class="CosmicTranscriber.QuickStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cosmic Transcriber - Quick start" Width="610" Height="540"
        MinWidth="340" MinHeight="320" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Background="{DynamicResource WindowGradientBrush}" Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="GuideViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="StepNumberText" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
                <TextBlock x:Name="StepTitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <TextBlock x:Name="StepBodyText" TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,0,0,18"/>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <TextBlock x:Name="StepTipText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" LineHeight="22"/>
                </Border>
                <Button x:Name="ShowAreaButton" Content="Show this area in the app" Click="ShowArea_Click"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                        AutomationProperties.Name="Show the related area without starting an action"/>
                <TextBlock Text="You can move this guide aside and keep using the main window." TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}"/>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseGuideButton" Content="Close guide" Click="CloseGuide_Click" Style="{StaticResource QuietButtonStyle}" Margin="0,4,8,0"/>
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,4,8,0"/>
            <Button x:Name="NextButton" Content="Next" Click="Next_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,4,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
