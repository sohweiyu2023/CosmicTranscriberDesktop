<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ThemeAppSource Condition="'$(ThemeAppSource)' == ''">../../src/CosmicTranscriber/App.xaml.cs</ThemeAppSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ThemeAppSource)" Link="Production/App.xaml.cs" />
    <Compile Include="../../src/CosmicTranscriber/GlobalUsings.cs" Link="Production/GlobalUsings.cs" />
    <Compile Include="../LayoutRegression/LayoutModels.cs" Link="Production/LayoutModels.cs" />
    <Page Include="../../src/CosmicTranscriber/Themes/*.xaml" Link="Themes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
