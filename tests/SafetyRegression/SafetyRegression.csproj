<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OpenAiClientSource Condition="'$(OpenAiClientSource)' == ''">../../src/CosmicTranscriber/Services/OpenAiTranscriptionClient.cs</OpenAiClientSource><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.13" />
    <Compile Include="../../src/CosmicTranscriber/GlobalUsings.cs" Link="Production/GlobalUsings.cs" />
    <Compile Include="../../src/CosmicTranscriber/Models/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="$(OpenAiClientSource)" Link="Production/Services/OpenAiTranscriptionClient.cs" />
    <Compile Include="../../src/CosmicTranscriber/Services/*.cs" Exclude="../../src/CosmicTranscriber/Services/OpenAiTranscriptionClient.cs" Link="Production/Services/%(Filename)%(Extension)" />
    <Compile Include="../../src/CosmicTranscriber/Utilities/*.cs" Link="Production/Utilities/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
